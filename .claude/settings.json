{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(py:*)",
      "Bash(pip install:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(npm run:*)",
      "Bash(npm install:*)",
      "Bash(npx:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git checkout -b:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "WebFetch(domain:power.larc.nasa.gov)",
      "WebFetch(domain:cmr.earthdata.nasa.gov)",
      "WebFetch(domain:disc.gsfc.nasa.gov)",
      "WebFetch(domain:www.earthdata.nasa.gov)",
      "WebFetch(domain:lpdaac.usgs.gov)",
      "WebFetch(domain:www.spaceappschallenge.org)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(**/.netrc)",
      "Read(**/_netrc)",
      "Bash(git push --force:*)"
    ]
  }
}
