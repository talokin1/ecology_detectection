# Copy to .env and fill in. Never commit .env.
# NASA Earthdata Login (https://urs.earthdata.nasa.gov) — backend/data scripts only
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
EARTHDATA_TOKEN=
# SI (LLM) provider key for the in-app assistant — backend only
ANTHROPIC_API_KEY=
# App
API_BASE_URL=http://localhost:8000
CACHE_DIR=data/cache
