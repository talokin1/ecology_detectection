# Frozen data is checked against sha256 in data/cache/MANIFEST.json: never convert line endings,
# or Windows checkouts with core.autocrlf=true get different bytes (and different hashes).
data/cache/** -text
data/catalog/sources/** -text
*.nc binary
# Yearly grids for the "your own area" tool (ADR-011): raw float32/int16, never text.
frontend/public/data/series/*.bin binary
