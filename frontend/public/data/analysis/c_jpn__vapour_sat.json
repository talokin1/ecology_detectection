rs":[2003,2004,2005,2006,2007,2008,2009,2010,2011,2012,2013,2014,2015,2016,2017,2018,2019,2020,2021,2022,2023,2024,2025],"counts":[2,1,0,1,1,0,0,2,2,1,2,0,2,2,1,2,2,0,1,2,3,6,3],"sen_per_decade":0.77,"p":0.0498,"early":{"label":"2003–2012","mean_per_year":1.0,"years":[2003,2012]},"late":{"label":"2016–2025","mean_per_year":2.2,"years":[2016,2025]},"q":0.2741,"passes_fdr":false,"display":{"subtitle":"Months per year that were more humid than 9 in 10 months of 2003–2022.","trend_text":"The change in this count could still be chance."}},"spatial":{"share_opposite_significant":0.0,"share_same_significant":0.0,"warn":false},"neighbour":null,"vs_world":null,"insights":[{"kind":"total_change","text":"Since 2003 water vapour in the air got about 5% higher.","detail":"Total change +1.03 kg/m² (95% range +0.41 to +1.65); as a share of the average: 95% range +1% to +8%.","evidence_level":"moderate","tested":false,"methods_anchor":"trend-test","numbers":{"total":1.033}},{"kind":"signal_noise","text":"Since about 2016 the change has been bigger than a normal year-to-year swing.","evidence_level":"descriptive","tested":false,"methods_anchor":"signal-noise","numbers":{"year":2016,"ratio_now":1.84}},{"kind":"season_unresolved","text":"Summer shows the fastest rise in water vapour, but the seasons are still too close to tell apart.","detail":"Summer: +0.74 kg/m² per decade; the other seasons +0.19 to +0.57. Their 95% ranges overlap.","evidence_level":"descriptive","tested":false,"methods_anchor":"seasons","numbers":{"fast":0.74}}],"insights_audit":{"tested":17,"passed":0,"shown":0,"q":0.05,"text":"Besides the main test, we ran 17 follow-up checks (12 months, 4 seasons, extreme months). None held up after correcting for running many tests at once (q = 0.05). That is a result too: no month or season stands out."},"deeper_checks":null,"provenance":{"dataset":"NASA AIRS (Aqua satellite) · TotH2OVap","version":"7.0","doi":"10.5067/UBENJB9D3T2H","landing_page":"https://doi.org/10.5067/UBENJB9D3T2H","accessed":"2026-11-15","processing":["one OPeNDAP DAP4 subset per monthly granule: SurfAirTemp_A, SurfAirTemp_D, TotH2OVap_A, TotH2OVap_D (no other fields)","masked fill value -9999","country value = mean of the 2° map squares that overlap the country, weighted by the overlapping area (mainland and islands within about 1,000 km)","monthly series 2003-01 to 2025-12 (complete years)","anomalies from the calendar-month normal; Sen's slope, Mann-Kendall (Yue-Wang), OLS with effective sample size (trend_stats.py)"],"synthetic":false,"caveat":"Data: NASA AIRS infrared sounder on the Aqua satellite, 1° squares, average of the ~1:30 am and ~1:30 pm passes; a satellite retrieval, not a weather model (MERRA-2 does use AIRS measurements, so the two are not fully independent) (averaged into 2° squares; coastal squares include some sea). The trend is a straight line through 2003–2025; it shows what changed, not why. The record is 23 years long, shorter than the 30 years usually used to describe a climate. AIRS sees mostly clear and partly cloudy skies, and its global water-vapour trend is much smaller than MERRA-2's (about +0.1 vs +0.5 kg/m² per decade, 2003–2025); treat this trend as not yet confirmed."}}