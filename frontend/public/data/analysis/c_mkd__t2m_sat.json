ean_per_year":2.1,"years":[2016,2025]},"q":0.0348,"passes_fdr":true,"display":{"subtitle":"Months per year that were hotter than 9 in 10 months of 2003–2022.","trend_text":"From about 0.8 a year in 2003–2012 to about 2.1 a year in 2016–2025."}},"spatial":{"share_opposite_significant":0.0,"share_same_significant":1.0,"warn":false},"neighbour":null,"insights":[{"kind":"total_change","text":"Since 2003 it got about 1.2 °C warmer.","detail":"Total change +1.2 °C (95% range +0.5 to +1.9).","evidence_level":"strong","tested":false,"methods_anchor":"trend-test","numbers":{"total":1.17}},{"kind":"signal_noise","text":"Since about 2010 the change has been bigger than a normal year-to-year swing.","evidence_level":"descriptive","tested":false,"methods_anchor":"signal-noise","numbers":{"year":2010,"ratio_now":3.77}},{"kind":"season_unresolved","text":"Winter shows the fastest warming, but the seasons are still too close to tell apart.","detail":"Winter: +0.96 °C per decade; the other seasons +0.15 to +0.45. Their 95% ranges overlap.","evidence_level":"descriptive","tested":false,"methods_anchor":"seasons","numbers":{"fast":0.961}},{"kind":"extremes","text":"Very hot months have become more common.","detail":"About 0.8 a year in 2003–2012, about 2.1 a year in 2016–2025. Counted: months hotter than 9 in 10 months of 2003–2022.","evidence_level":"moderate","tested":true,"methods_anchor":"extremes","numbers":{"early":0.8,"late":2.1},"q":0.0348}],"insights_audit":{"tested":17,"passed":1,"shown":1,"q":0.05,"text":"Besides the main test, we ran 17 follow-up checks (12 months, 4 seasons, extreme months). 1 held up after correcting for running many tests at once (false discovery rate q = 0.05); most of them repeat the main trend month by month. Findings marked “follow-up check” come from these checks."},"deeper_checks":null,"provenance":{"dataset":"NASA AIRS (Aqua satellite) · SurfAirTemp","version":"7.0","doi":"10.5067/UBENJB9D3T2H","landing_page":"https://doi.org/10.5067/UBENJB9D3T2H","accessed":"2026-11-15","processing":["one OPeNDAP DAP4 subset per monthly granule: SurfAirTemp_A, SurfAirTemp_D, TotH2OVap_A, TotH2OVap_D (no other fields)","masked fill value -9999","country value = mean of the 2° map squares that overlap the country, weighted by the overlapping area (mainland and islands within about 1,000 km)","monthly series 2003-01 to 2025-12 (complete years)","anomalies from the calendar-month normal; Sen's slope, Mann-Kendall (Yue-Wang), OLS with effective sample size (trend_stats.py)"],"synthetic":false,"caveat":"Data: NASA AIRS infrared sounder on the Aqua satellite, 1° squares, average of the ~1:30 am and ~1:30 pm passes; a satellite retrieval, not a weather model (MERRA-2 does use AIRS measurements, so the two are not fully independent) (averaged into 2° squares; coastal squares include some sea). The trend is a straight line through 2003–2025; it shows what changed, not why. The record is 23 years long, shorter than the 30 years usually used to describe a climate. Over hot deserts AIRS and MERRA-2 agree poorly (infrared retrievals over bright desert surfaces are hard), so read desert results with care; elsewhere the two usually agree."}}