3,2024,2025],"counts":[5,1,1,3,0,0,1,3,2,0,1,0,2,2,1,0,1,0,0,1,0,4,1],"sen_per_decade":0.0,"p":0.2916,"early":{"label":"2003–2012","mean_per_year":1.6,"years":[2003,2012]},"late":{"label":"2016–2025","mean_per_year":1.0,"years":[2016,2025]},"q":0.6197,"passes_fdr":false,"display":{"subtitle":"Months per year that were more humid than 9 in 10 months of 2003–2022.","trend_text":"The change in this count could still be chance."}},"spatial":{"share_opposite_significant":0.0,"share_same_significant":0.0,"warn":false},"neighbour":null,"vs_world":null,"insights":[{"kind":"caveat","text":"This satellite record starts in 2003. The longer 1981–2025 record (NASA POWER (MERRA-2)) for this place says: strong evidence: holding more water vapour, +0.20 kg/m² per decade. A shorter window can show a different direction.","evidence_level":"descriptive","tested":false,"methods_anchor":"trend-test","numbers":{"long_record_rate":0.202}},{"kind":"total_change","text":"Since 2003 water vapour in the air got about 8% lower.","detail":"Total change −0.57 kg/m² (95% range −0.90 to −0.24); as a share of the average: 95% range −13% to −3%.","evidence_level":"moderate","tested":false,"methods_anchor":"trend-test","numbers":{"total":-0.571}},{"kind":"signal_noise","text":"Since about 2014 the change has been bigger than a normal year-to-year swing.","evidence_level":"descriptive","tested":false,"methods_anchor":"signal-noise","numbers":{"year":2014,"ratio_now":2.29}},{"kind":"season_unresolved","text":"Summer shows the fastest drop in water vapour, but the seasons are still too close to tell apart.","detail":"Summer: −0.48 kg/m² per decade; the other seasons −0.35 to −0.09. Their 95% ranges overlap.","evidence_level":"descriptive","tested":false,"methods_anchor":"seasons","numbers":{"fast":-0.476}}],"insights_audit":{"tested":17,"passed":0,"shown":0,"q":0.05,"text":"Besides the main test, we ran 17 follow-up checks (12 months, 4 seasons, extreme months). None held up after correcting for running