0.0113,"passes_fdr":true},{"month":8,"label":"Aug","name":"August","sen_per_decade":14.99,"ci95":[4.855,22.687],"ci_text":"95% range +4.8 to +22.7","display":"+15.0","p":0.0074,"q":0.0113,"passes_fdr":true},{"month":9,"label":"Sep","name":"September","sen_per_decade":14.75,"ci95":[3.175,22.608],"ci_text":"95% range +3.1 to +22.7","display":"+14.8","p":0.0091,"q":0.0121,"passes_fdr":true},{"month":10,"label":"Oct","name":"October","sen_per_decade":14.74,"ci95":[6.244,22.786],"ci_text":"95% range +6.2 to +22.8","display":"+14.7","p":0.0038,"q":0.0077,"passes_fdr":true},{"month":11,"label":"Nov","name":"November","sen_per_decade":13.76,"ci95":[6.496,23.184],"ci_text":"95% range +6.4 to +23.2","display":"+13.8","p":0.0034,"q":0.0077,"passes_fdr":true},{"month":12,"label":"Dec","name":"December","sen_per_decade":13.87,"ci95":[5.792,22.104],"ci_text":"95% range +5.7 to +22.2","display":"+13.9","p":0.0022,"q":0.0065,"passes_fdr":true}],"extremes":null,"spatial":{"share_opposite_significant":0.0,"share_same_significant":0.484,"warn":false},"neighbour":null,"insights":[{"kind":"total_change","text":"Since 2003 the water stored on land got about 34.3 cm higher.","detail":"Total change +34.3 cm (95% range +11.1 to +54.7).","evidence_level":"strong","tested":false,"methods_anchor":"trend-test","numbers":{"total":34.33}},{"kind":"signal_noise","text":"Since about 2009 the change has been bigger than a normal year-to-year swing.","evidence_level":"descriptive","tested":false,"methods_anchor":"signal-noise","numbers":{"year":2009,"ratio_now":4.45}},{"kind":"season_unresolved","text":"Summer shows the fastest gain in stored water, but the seasons are still too close to tell apart.","detail":"Summer: +18.0 cm per decade; the other seasons +15.3 to +15.7. Their 95% ranges overlap.","evidence_level":"descriptive","tested":false,"methods_anchor":"seasons","numbers":{"fast":17.96}}],"insights_audit":{"tested":16,"passed":16,"shown":0,"q":0.05,"text":"Besides the main test, we ran 16 follow-up checks (12 months and 4 seasons). 16 held up after correcting for running many tests at once (false discovery rate q = 0.05); most of them repeat the main trend month by month. Findings marked “follow-up check” come from these checks."},"deeper_checks":null,"provenance":{"dataset":"NASA/DLR GRACE and NASA/GFZ GRACE-FO (JPL mascons) · lwe_thickness","version":"RL06.3Mv04","doi":"10.5067/TEMSC-3JC634","landing_page":"https://podaac.jpl.nasa.gov/dataset/TELLUS_GRAC-GRFO_MASCON_CRI_GRID_RL06.3_V4","accessed":"2026-11-14","processing":["converted longitudes 0..360 to -180..180","kept land cells only (product land_mask == 1)","country value = mean of the 2° map squares that overlap the country, weighted by the overlapping area (mainland and islands within about 1,000 km)","monthly series 2003-01 to 2025-12 (complete years)","anomalies from the calendar-month normal; Sen's slope, Mann-Kendall (Yue-Wang), OLS with effective sample size (trend_stats.py)"],"synthetic":false,"caveat":"Data: NASA/DLR GRACE and NASA/GFZ GRACE-FO satellites, which weigh the water on land by its gravity; JPL mascon solution RL06.3, blocks of about 300 km (averaged into 2° squares; coastal squares include some sea). The trend is a straight line through 2003–2025; it shows what changed, not why. The record is 23 years long, shorter than the 30 years usually used to describe a climate. GRACE weighs all water together (it cannot say whether groundwater, soil or snow changed), sees blocks of about 300 km, and has no data from mid-2017 to mid-2018 between the two missions; months without data are left out, never filled."}}