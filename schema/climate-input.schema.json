{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline climate statistics input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "series"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "metadata": {"type": "object"},
    "config": {"$ref": "#/$defs/config"},
    "series": {
      "type": "array", "minItems": 1, "maxItems": 200,
      "items": {"allOf": [{"$ref": "#/$defs/series"}, {"required": ["variable_id"]}]}
    },
    "covariates": {"type": "array", "items": {"$ref": "#/$defs/series"}},
    "controls": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["series_id", "covariate_ids"],
        "properties": {
          "series_id": {"type": "string", "minLength": 1},
          "covariate_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "months": {"type": "array", "minItems": 1, "uniqueItems": true,
                     "items": {"type": "integer", "minimum": 1, "maximum": 12}}
        }
      }
    }
  },
  "$defs": {
    "series": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "region_id", "frequency", "units", "values"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "variable_id": {"type": "string", "minLength": 1, "description": "Exact id from variables.yaml; checked at runtime."},
        "region_id": {"type": "string", "minLength": 1},
        "frequency": {"enum": ["daily", "monthly", "annual"]},
        "units": {"type": "string", "minLength": 1},
        "latitude": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
        "fill_values": {"type": "array", "items": {"type": "number"}},
        "semantics": {"enum": ["mean_daily_maximum", "mean_daily_minimum"]},
        "provenance": {"type": "object"},
        "values": {
          "type": "array", "minItems": 1, "maxItems": 200000,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["date", "value"],
            "properties": {
              "date": {"type": "string", "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"},
              "value": {"type": ["number", "null"]}
            }
          }
        }
      }
    },
    "config": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "baseline": {"type": ["array", "null"], "minItems": 2, "maxItems": 2,
                     "items": {"type": "integer", "minimum": 1800, "maximum": 2200}},
        "alpha": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "fdr_q": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "min_years": {"type": "integer", "minimum": 4, "maximum": 200},
        "min_climatology_years": {"type": "integer", "minimum": 2, "maximum": 100},
        "min_coverage": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "daily_min_coverage": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1},
        "annual_months": {"type": "array", "minItems": 1, "uniqueItems": true,
                          "items": {"type": "integer", "minimum": 1, "maximum": 12}},
        "annual_missing_policy": {"enum": ["strict", "climatology_adjusted"]},
        "annual_min_coverage": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "bootstrap_samples": {"type": "integer", "minimum": 0, "maximum": 10000},
        "block_months": {"type": "integer", "minimum": 1, "maximum": 120},
        "block_years": {"type": "integer", "minimum": 1, "maximum": 30},
        "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "split_year": {"type": ["integer", "null"], "minimum": 1800, "maximum": 2200},
        "drought_scales": {"type": "array", "minItems": 1, "uniqueItems": true,
                           "items": {"type": "integer", "minimum": 1, "maximum": 24}},
        "drought_end_month": {"type": "integer", "minimum": 1, "maximum": 12},
        "min_drought_baseline_years": {"type": "integer", "minimum": 10, "maximum": 100},
        "quantiles": {"type": "array", "minItems": 1, "uniqueItems": true,
                      "items": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}},
        "correlation_lags": {"type": "array", "minItems": 1, "uniqueItems": true,
                             "items": {"type": "integer", "minimum": 0, "maximum": 36}},
        "include_series": {"type": "boolean"},
        "methods": {
          "type": "array", "uniqueItems": true,
          "items": {"enum": ["trend", "monthly_profile", "seasonal", "emergence", "probability", "quantiles",
                             "acceleration", "variability", "bootstrap", "change_point", "indices", "drought",
                             "relationships", "drivers"]}
        }
      }
    }
  }
}
