{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "compare.schema.json",
  "title": "Compare",
  "description": "Trend of the difference A minus B over common months (S10). differ is true only when that trend is significant.",
  "type": "object",
  "required": ["schema_version", "variable_id", "region_a", "region_b", "diff_sen_per_decade", "ci95", "p", "level", "differ", "answer", "sentence", "display", "provenance"],
  "properties": {
    "schema_version": { "type": "string" },
    "variable_id": { "type": "string" },
    "region_a": { "type": "string" },
    "region_b": { "type": "string" },
    "diff_sen_per_decade": { "type": "number" },
    "ci95": { "$ref": "common.schema.json#/$defs/Range" },
    "p": { "type": "number" },
    "level": { "$ref": "common.schema.json#/$defs/Level" },
    "differ": { "type": "boolean" },
    "answer": { "type": "string" },
    "sentence": { "type": "string" },
    "display": {
      "type": "object",
      "required": ["rate", "range"],
      "properties": { "rate": { "type": "string" }, "range": { "type": "string" } },
      "additionalProperties": false
    },
    "provenance": { "$ref": "common.schema.json#/$defs/Provenance" }
  },
  "additionalProperties": false
}
